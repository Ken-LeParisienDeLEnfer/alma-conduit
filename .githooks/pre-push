#!/bin/sh
# Heavier gate before code leaves the machine: both linters plus both test
# suites. Wired up via `make install-hooks`. Reuses the exact same Make
# targets CI runs, so "passes locally" and "passes in CI" mean the same
# thing.
#
# Skip on a one-off push with: git push --no-verify
set -e

echo "[pre-push] Linting backend..."
make lint-backend

echo "[pre-push] Linting frontend..."
make lint-frontend

echo "[pre-push] Running backend tests..."
make test-backend

echo "[pre-push] Running frontend tests..."
make test-frontend
